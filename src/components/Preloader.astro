---
---

<div id="preloader" class="preloader">
  <div class="preloader__morph">
    <div class="preloader__morph-inner">
      <div class="preloader__morph-dot" style="animation: morph-0 2s infinite ease-in-out; animation-delay: 0s;"></div>
      <div class="preloader__morph-dot" style="animation: morph-1 2s infinite ease-in-out; animation-delay: 0.2s;"></div>
      <div class="preloader__morph-dot" style="animation: morph-2 2s infinite ease-in-out; animation-delay: 0.4s;"></div>
      <div class="preloader__morph-dot" style="animation: morph-3 2s infinite ease-in-out; animation-delay: 0.6s;"></div>
    </div>
  </div>
</div>

<style>
  .preloader {
    position: fixed;
    inset: 0;
    z-index: 99999;
    background-color: var(--color-bg, #0A0A0A);
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .preloader__morph {
    position: relative;
    width: 8rem;
    height: 8rem;
  }

  .preloader__morph-inner {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .preloader__morph-dot {
    position: absolute;
    width: 1rem;
    height: 1rem;
    background-color: var(--color-text, #E8E4DE);
  }
</style>
